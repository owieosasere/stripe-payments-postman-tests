    {
      "name": "Idempotency test",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\nvar firstId = pm.response.json().id;\n\npm.sendRequest({\n    url: pm.environment.get(\"base_url\") + \"/payment_intents\",\n    method: \"POST\",\n    header: {\n        \"Authorization\": \"Bearer \" + pm.environment.get(\"secret_key\"),\n        \"Idempotency-Key\": pm.environment.get(\"idem_key\")\n    },\n    body: {\n        mode: \"urlencoded\",\n        urlencoded: [\n            { key: \"amount\", value: \"2000\" },\n            { key: \"currency\", value: \"gbp\" },\n            { key: \"payment_method\", value: \"pm_card_visa\" },\n            { key: \"confirm\", value: \"true\" },\n            { key: \"automatic_payment_methods[enabled]\", value: \"true\" },\n            { key: \"automatic_payment_methods[allow_redirects]\", value: \"never\" }\n        ]\n    }\n}, function (err, res) {\n    pm.test(\"Repeat with same key returns the same payment\", function () {\n        pm.expect(res.json().id).to.eql(firstId);\n    });\n});"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set(\"idem_key\", \"demo-\" + Date.now());"
            ]
          }
        }
      ],
